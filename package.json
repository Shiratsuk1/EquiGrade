{
  "name": "physics-grading-console",
  "private": true,
  "version": "0.1.3",
  "description": "面向高中物理大题的本地自动改卷与网页流水线工作台",
  "author": "Hengzhun",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/run-dev.mjs web",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build:server": "tsc -p tsconfig.server.json",
    "build:electron": "tsc -p tsconfig.electron.json && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/electron/preload.cjs && esbuild electron/targetPreload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/electron/targetPreload.cjs",
    "electron:dev": "npm run build:electron && node scripts/run-dev.mjs electron",
    "electron:run": "electron dist-electron/electron/main.js",
    "package:win": "npm run build && npm run build:server && npm run build:electron && electron-builder --win --x64",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "express": "^5.1.0",
    "katex": "^0.18.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.3",
    "zod": "^4.0.0"
  },
  "build": {
    "appId": "com.hengzhun.physics-grading",
    "productName": "衡准自动改卷工作台",
    "artifactName": "${productName}-${version}-Windows-x64-Setup.${ext}",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/**/*",
      "dist-server/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
