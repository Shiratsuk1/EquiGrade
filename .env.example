PORT=8787
VITE_API_URL=http://localhost:8787

# Model and PaddleOCR requests connect directly by default for the local
# Zhilian model service. Set this only when an HTTP(S) proxy is explicitly
# required; use direct (or an empty value) to force direct connections.
# HENGZHUN_MODEL_PROXY_URL=direct

# Student answer image preprocessing before OCR/vision-model calls.
# enhanced (default): send only the geometry-preserving enhanced result;
# off: skip enhancement and send the input image as the single downstream image.
# The legacy value dual is accepted as an alias for enhanced.
# HENGZHUN_STUDENT_IMAGE_PREPROCESSING=enhanced

# Per-grading artifacts are written under ./grading-artifacts by default.
# Set an explicit absolute directory when the API process is started elsewhere.
# HENGZHUN_GRADING_ARTIFACT_DIR=F:/ChatGPT/改卷系统/grading-artifacts

# Optional: use only when the model host is protected by Cloudflare Access.
# The server sends these headers only when the request hostname exactly matches.
# HENGZHUN_CLOUDFLARE_ACCESS_HOST=api.example.com
# HENGZHUN_CLOUDFLARE_ACCESS_CLIENT_ID=
# HENGZHUN_CLOUDFLARE_ACCESS_CLIENT_SECRET=

# Optional PaddleOCR-VL service settings for the OCR block/bbox stage of
# large-question and small-question grading.
# The access token is read at runtime only; never write it to this file.
# PADDLEOCR_MCP_AISTUDIO_ACCESS_TOKEN=
# PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
# PADDLEOCR_MODEL=PaddleOCR-VL-1.6
# PADDLEOCR_POLL_INTERVAL_MS=5000
# PADDLEOCR_TIMEOUT_MS=600000
